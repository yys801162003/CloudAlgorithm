#pragma code_page(65001)
#include <windows.h>
#include "resource.h"
LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
IDD_MAIN_DIALOG DIALOGEX 0, 0, 800, 520
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "图片烟雾识别 — OpenCV 规则与神经网络"
FONT 9, "Microsoft YaHei UI"
BEGIN
    PUSHBUTTON "打开 PNG / JPEG", IDC_OPEN, 8, 8, 100, 22
    PUSHBUTTON "OpenCV 检测", IDC_RUN_CV, 114, 8, 90, 22
    PUSHBUTTON "神经网络检测", IDC_RUN_NN, 210, 8, 90, 22
    DEFPUSHBUTTON "两种方法对比", IDC_RUN_BOTH, 306, 8, 90, 22
    PUSHBUTTON "取消", IDC_CANCEL, 402, 8, 58, 22
    PUSHBUTTON "导出结果", IDC_EXPORT, 466, 8, 72, 22
    LTEXT "OpenCV 疑似面积阈值（%）", -1, 8, 40, 140, 14
    EDITTEXT IDC_AREA_THRESHOLD, 150, 36, 60, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "神经网络分数阈值（0~1）", -1, 232, 40, 140, 14
    EDITTEXT IDC_NN_THRESHOLD, 376, 36, 60, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "OpenCV 面积比例不等于概率；神经网络分数不保证已校准。", -1, 454, 40, 334, 14
    LTEXT "尚未选择图片。", IDC_PATH, 8, 66, 784, 16, SS_PATHELLIPSIS
    LTEXT "模型：firewatch YOLO11s v0.1.0 | 烟雾=0，火焰=1 | CPU 本地推理", IDC_MODEL, 8, 86, 784, 16, SS_ENDELLIPSIS
    LTEXT "输入图片", IDC_TITLE_ORIGINAL, 8, 108, 252, 16
    LTEXT "OpenCV 规则结果", IDC_TITLE_CV, 274, 108, 252, 16
    LTEXT "神经网络结果", IDC_TITLE_NN, 540, 108, 252, 16
    CONTROL "", IDC_VIEW_ORIGINAL, "SmokeImagePreview", WS_CHILD | WS_VISIBLE | WS_BORDER, 8, 128, 252, 244
    CONTROL "", IDC_VIEW_CV, "SmokeImagePreview", WS_CHILD | WS_VISIBLE | WS_BORDER, 274, 128, 252, 244
    CONTROL "", IDC_VIEW_NN, "SmokeImagePreview", WS_CHILD | WS_VISIBLE | WS_BORDER, 540, 128, 252, 244
    EDITTEXT IDC_REPORT, 8, 380, 784, 106, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "选择图片后点击检测。所有图像分析均在本机完成。", IDC_STATUS, 8, 496, 784, 16, SS_ENDELLIPSIS
END
